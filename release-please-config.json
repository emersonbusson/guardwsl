{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "separate-pull-requests": false,
  "bump-minor-pre-major": false,
  "bump-patch-for-minor-pre-major": false,
  "draft": false,
  "force-tag-creation": true,
  "skip-github-release": false,
  "pull-request-title-pattern": "chore${scope}: release guardwsl v${version}",
  "group-pull-request-title-pattern": "chore: release guardwsl v${version}",
  "pull-request-header": "Release PR generated by release-please.\n\nMerging this PR creates the `v${version}` tag and the GitHub release automatically.\n\n## Validation\n\n- [ ] CI passes on this SHA.\n- [ ] `CHANGELOG.md` lists the intended changes.\n- [ ] `Cargo.toml` and `Cargo.lock` carry the same version.\n",
  "changelog-sections": [
    { "type": "feat",     "section": "Features",      "hidden": false },
    { "type": "fix",      "section": "Bug Fixes",     "hidden": false },
    { "type": "perf",     "section": "Performance",   "hidden": false },
    { "type": "refactor", "section": "Refactor",      "hidden": false },
    { "type": "docs",     "section": "Documentation", "hidden": false },
    { "type": "ci",       "section": "CI",            "hidden": false },
    { "type": "build",    "section": "Build",         "hidden": true  },
    { "type": "test",     "section": "Tests",         "hidden": true  },
    { "type": "chore",    "section": "Chores",        "hidden": true  },
    { "type": "style",    "section": "Style",         "hidden": true  }
  ],
  "packages": {
    ".": {
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        "Cargo.toml",
        {
          "type": "generic",
          "path": "Cargo.lock"
        }
      ]
    }
  }
}
