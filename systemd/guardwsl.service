[Unit]
Description=GuardWSL disk guardian

[Service]
Type=simple
ExecStart=%h/.local/bin/guard monitor
Restart=on-failure
RestartSec=10s
TimeoutStopSec=15s
# Optional non-interactive sudo is used only for read-only /proc inspection
# and guest fstrim; without it, hidden processes block every safe cleanup.
NoNewPrivileges=false
Nice=10
MemoryMax=512M
TasksMax=64

[Install]
WantedBy=default.target
